{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pesu-rs",
  "version": "0.1.0",
  "identifier": "io.github.pesu.rs",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "pesu-rs",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": false,
        "maximized": true,
        "fullscreen": false,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://avatars.githubusercontent.com https://github.com; connect-src 'self' https://avatars.githubusercontent.com https://api.github.com"
    }
  },
  "bundle": {
    "active": false
  }
}
